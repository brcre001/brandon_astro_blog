---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Card from "../components/Card.astro";
import "../styles/global.css";
---

<Layout title="About | B.DEV">
    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-inner-container">
                <h1 class="text-gradient">Crafting Digital Experiences</h1>
                <p class="hero-text">
                    We transform ideas into exceptional digital solutions, creating websites 
                    and applications that make a lasting impact.
                </p>
            </div>
        </section>

        <!-- About Section -->
        <section class="about-section">
            <div class="about-section-inner-container">
                <div class="content-wrapper">
                    <h2>Our Story</h2>
                    <p>
                        With over a decade of experience in web development and design, 
                        we've helped countless businesses establish their digital presence. 
                        Our passion lies in creating seamless, user-friendly experiences 
                        that drive results.
                    </p>
                    <p>
                        We believe in staying ahead of the curve, continuously learning 
                        and adapting to new technologies while maintaining our commitment 
                        to quality and innovation.
                    </p>
                </div>
            </div>
        </section>

        <!-- Image & Text Section -->
        <section class="feature-section">
            <div class="feature-section-inner-container">
                <div class="image-container">
                    <img src="/images/workspace.jpg" alt="Modern workspace with computers" />
                </div>
                <div class="text-container">
                    <h2>How We Work</h2>
                    <p>
                        Our approach combines technical expertise with creative problem-solving. 
                        We focus on delivering solutions that are not just visually stunning 
                        but also performant and scalable.
                    </p>
                    <ul class="feature-list">
                        <li>✨ Modern Technology Stack</li>
                        <li>🚀 Performance-First Approach</li>
                        <li>💡 Innovative Solutions</li>
                        <li>🤝 Collaborative Development</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section class="services-section">
            <h2>Our Services</h2>
            <div class="link-card-grid">
                <Card
                    href="/services/web-design"
                    title="Web Design"
                    body="Creating beautiful, responsive websites that capture your brand's essence."
                />
                <Card
                    href="/services/development"
                    title="Web Development"
                    body="Building robust applications with modern frameworks and technologies."
                />
                <Card
                    href="/services/support"
                    title="Technical Support"
                    body="Providing ongoing maintenance and support for your digital solutions."
                />
            </div>
        </section>
    </main>
</Layout>

<style lang="scss" is:global>
    main {
        margin: auto;
        color: white;
        font-size: 18px;
        line-height: 1.6;
        
        section {
            padding: 4rem 1rem;
        }
    }

    .hero {
        text-align: center;
        padding: 8rem 1rem 6rem;
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/hero-bg.jpg') center/cover;
        
        .hero-inner-container {
            max-width: 1200px;
            margin: 0 auto;

            h1 {
                font-size: 4rem;
                margin-bottom: 1rem;

                @media screen and (max-width: 768px) {
                    font-size: 3rem;
                }
            }

            .hero-text {
                font-size: 1.5rem;
                max-width: 800px;
                margin: 0 auto;
            }
        }
    }

    .about-section {
        background: rgba(255,255,255,0.05);

        .about-section-inner-container {
            max-width: 800px;
            margin: 0 auto;

            .content-wrapper {
                max-width: 800px;
                margin: 0 auto;
                text-align: center;
            }
        }
    }

    .feature-section {
        .feature-section-inner-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            max-width: 800px;
            margin: 0 auto;


            @media (max-width: 768px) {
                grid-template-columns: 1fr;
            }

            .image-container {
                img {
                    width: 100%;
                    height: auto;
                    border-radius: 10px;
                }
            }

            .feature-list {
                list-style: none;
                padding: 0;
                margin-top: 2rem;

                li {
                    margin: 1rem 0;
                    font-size: 1.1rem;
                }
            }
        }
    }

    .services-section {
        background: rgba(255,255,255,0.05);
        text-align: center;

        h2 {
            margin-bottom: 1.5rem;
        }

        .link-card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            padding: 0;
            max-width: 1200px;
            margin: 0 auto;
        }
    }

    h2 {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        color: var(--accent-gradient);
    }
</style>